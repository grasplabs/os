{
  "name": "@grasp-os/compiler",
  "private": true,
  "description": "Screen compiler: builds an App's screens into ES modules and CSS, in its own isolate",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#isolate": {
      "types": "./src/isolate.d.ts",
      "default": "./dist/isolate.js"
    },
    "#kit": {
      "types": "./src/kit-module.d.ts",
      "default": "./dist/kit.json"
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node build.ts"
  },
  "dependencies": {
    "@babel/standalone": "catalog:",
    "@grasp-os/ui": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "eslint": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:typescript6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "ultracite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
