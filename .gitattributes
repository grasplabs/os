# Keep text files stable across Windows, macOS and Linux.
* text=auto eol=lf

# Generated files: collapsed in pull request diffs. Regenerate them after a
# conflict instead of merging by hand.
pnpm-lock.yaml linguist-generated=true
**/routeTree.gen.ts linguist-generated=true
**/worker-configuration.d.ts linguist-generated=true
**/migrations/meta/** linguist-generated=true

# Binary assets are never line-ending normalized.
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
