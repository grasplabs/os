// grasp-os-staging deployment. Client deployments are provisioned by the console,
// which creates every resource below with EU jurisdiction.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grasp-os-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Durable Objects bundle their Drizzle migrations as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // Core logs one structured line per request itself (src/log.ts), so the
  // platform's own line per invocation would only double every entry.
  // Query strings stay out of logs and traces: the OAuth callback's carries
  // the code and state (threat model R17, CN3).
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true },
  },
  // The frontend (apps/web) is served as static files by core. The Worker runs
  // first for every path, so static files too pass the router-secret check
  // before it serves them through the ASSETS binding.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  // The console sets the deployment config vars below (SIGN_IN,
  // MODEL_GATEWAY, FEATURES) through the API; without this, every deploy
  // would delete them, as Wrangler deletes the vars it doesn't find here.
  "keep_vars": true,
  // Every secret core needs: deploys fail while one is unset, and local dev
  // loads only these from .dev.vars. ROUTER_SECRET is shared with the router,
  // which sends it on every request. BETTER_AUTH_SECRET signs session cookies
  // and encrypts sign-in state. CAPABILITY_SIGNING_KEY is shared with
  // connect: core signs the capability every call to connect carries.
  //
  // Sign-in is deployment config the console sets, not listed here: the
  // `SIGN_IN` var (src/auth/config.ts) and the client secret of each IdP it
  // names, ENTRA_CLIENT_SECRET and GOOGLE_CLIENT_SECRET. Without them nobody
  // can sign in.
  //
  // So is the model gateway: the `MODEL_GATEWAY` var (src/models.ts) names
  // the deployment's AI Gateway and the models it allows. It needs no secret:
  // provider keys stay in AI Gateway. Without it every model call is refused.
  //
  // So are feature flags: the `FEATURES` var (src/features.ts), e.g.
  // `{"apps": true}`. Every feature is off until it names it.
  //
  // And the audit log's retention: the `AUDIT_RETENTION_DAYS` var
  // (src/audit-retention.ts), 180 days unless set, at least 30. And how long
  // its archive keeps them: `AUDIT_ARCHIVE_RETENTION_DAYS` (src/audit-log.ts),
  // at least 365; archived events are never purged while it's unset.
  //
  // Local dev reads none of these from .dev.vars (Wrangler loads only the
  // required secrets and declared vars from it): pass them with
  // `wrangler dev --var NAME:<value>`, as core's dev script does for its own
  // switches. Their types are in src/env.d.ts.
  "secrets": {
    "required": [
      "ROUTER_SECRET",
      "BETTER_AUTH_SECRET",
      "CAPABILITY_SIGNING_KEY",
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "Workspace" },
      { "name": "APPS", "class_name": "App" },
      { "name": "AUDIT_LOG", "class_name": "AuditLog" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Workspace", "App", "AuditLog"] },
  ],
  // The one dispatcher of every App's workflow runs (src/workflows/): it
  // loads each run's code by App and pinned version, with an env rebuilt
  // from permissions on every start and resume. Runs are created with the
  // `weur` location hint.
  "workflows": [
    {
      "name": "grasp-os-workflows",
      "binding": "WORKFLOWS",
      "class_name": "WorkflowDispatcher",
    },
  ],
  // Runs App sandboxes and the screen compiler.
  "worker_loaders": [{ "binding": "LOADER" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grasp-os-core",
      "migrations_dir": "src/db/core/migrations",
    },
    {
      "binding": "KNOWLEDGE",
      "database_name": "grasp-os-knowledge",
      "migrations_dir": "src/db/knowledge/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "grasp-os-files",
      "jurisdiction": "eu",
    },
    // Audit events past retention, moved out of the AuditLog object as they
    // were stored (src/audit-log.ts). Only core writes it.
    {
      "binding": "AUDIT_ARCHIVE",
      "bucket_name": "grasp-os-audit-archive",
      "jurisdiction": "eu",
    },
  ],
  // Audit events from core and connect, appended to the AuditLog object.
  // Delivery is at least once; events that keep failing land in the dead
  // letter queue instead of being lost. The consumer moves an event the log
  // can never take (over its size cap) there itself, without retrying it.
  "queues": {
    "producers": [
      { "binding": "AUDIT_QUEUE", "queue": "grasp-os-audit" },
      { "binding": "AUDIT_DLQ", "queue": "grasp-os-audit-dlq" },
    ],
    "consumers": [
      {
        "queue": "grasp-os-audit",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "grasp-os-audit-dlq",
      },
    ],
  },
  // Sends audit events left in the outbox when their first send failed, and
  // archives audit events past retention (src/index.ts).
  "triggers": { "crons": ["* * * * *"] },
  // The model gateway's transport to AI Gateway (src/models.ts); core never
  // holds a raw provider key.
  "ai": { "binding": "AI", "remote": true },
  "send_email": [{ "name": "EMAIL" }],
  "services": [{ "binding": "CONNECT", "service": "grasp-os-connect" }],
}
