{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // drizzle-kit writes each Durable Object's migrations.js.
    "allowJs": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    // Keeps the browser's globals out of a Worker's types (see the file).
    "paths": { "@xmldom/xmldom": ["./types/xmldom.d.ts"] }
  },
  "include": ["src", "test", "types", "worker-configuration.d.ts", "*.ts"]
}
