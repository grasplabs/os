// Reached only through core's service binding, never from the internet.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grasp-os-connect",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // global_fetch_strictly_public: connect's own calls out (to Composio's MCP
  // servers) can't reach private or internal addresses, even when a public
  // name resolves to one.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // No platform line per invocation: connect logs what it needs itself, and
  // never tokens, headers or bodies (threat model R17). Query strings stay
  // out of logs and traces too.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true },
  },
  // Every secret connect needs: deploys fail while one is unset, and local
  // dev loads only these from .dev.vars. CAPABILITY_SIGNING_KEY is shared
  // with core, which signs a capability for every call connect gets.
  //
  // Connecting accounts needs more, set by the console, but connect takes
  // calls without them, so they aren't required: TOKEN_ENCRYPTION_KEY, which
  // seals OAuth tokens (src/vault.ts), and each provider's app credentials,
  // MICROSOFT_CLIENT_ID and _SECRET, GOOGLE_CLIENT_ID and _SECRET
  // (src/providers.ts). While one is unset, connecting that provider is
  // refused. Their types are in src/env.d.ts.
  "secrets": { "required": ["CAPABILITY_SIGNING_KEY"] },
  // Loads a native connector into an isolate of its own for each call
  // (src/connectors.ts); a new connector needs no entry here.
  "worker_loaders": [{ "binding": "LOADER" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grasp-os-connect",
      // Local only: `vp run dev` runs connect next to core, which binds its
      // own database as DB too; this keeps the two local databases apart.
      "preview_database_id": "grasp-os-connect",
      "migrations_dir": "src/db/migrations",
    },
  ],
  // Sends the audit events whose first send failed.
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "AUDIT_QUEUE", "queue": "grasp-os-audit" }],
  },
}
