// Reached only through core's service binding, never from the internet.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grasp-os-connect",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  // Loads each native connector into its own isolate.
  "worker_loaders": [{ "binding": "LOADER" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grasp-os-connect",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "AUDIT_QUEUE", "queue": "grasp-os-audit" }],
  },
}
